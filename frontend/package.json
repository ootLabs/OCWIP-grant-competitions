    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "axe-core": "4.13.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",

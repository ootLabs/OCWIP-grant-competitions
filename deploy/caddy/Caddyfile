# The public entrance (T-111): TLS, HSTS and one address for both halves.
# /api goes to the API with the prefix stripped, because the API's routes
# have none and /competitions exists both as an API route and as a page.
{
	# The admin API only inside the container, for the healthcheck.
	admin 127.0.0.1:2019
}

{$DOMAIN} {
	# An e-mail address for Let's Encrypt, or "internal" for a test machine.
	tls {$CADDY_TLS}

	# Additions of one environment only (T-117): staging puts its password,
	# noindex and the Mailpit route here (docker-compose.staging.yml);
	# production has nothing in this directory.
	import /etc/caddy/site.d/*.caddy

	encode zstd gzip

	# The largest attachment a competition may allow plus the envelope, the
	# same number as Kestrel's limit (CompetitionRequestValidator.MaxRequestBodySize).
	request_body {
		max_size 26MiB
	}

	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# The proxy names no technology, its own or the upstreams'.
	header -Server
	header -X-Powered-By

	handle_path /api/* {
		reverse_proxy backend:8080
	}

	# Static assets never pass through the front end's middleware, so the
	# headers it sets on pages are added here (S-46).
	handle /_next/static/* {
		header X-Content-Type-Options nosniff
		header Cross-Origin-Resource-Policy same-origin
		header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		reverse_proxy frontend:3000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

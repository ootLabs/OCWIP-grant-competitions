# The settings of docker-compose.prod.yml (T-111). Copy to .env.prod on the
# server, fill in, keep out of git. Every line without a default is required:
# docker compose refuses to start and names what is missing.

# The public host name, without https:// and without a slash.
DOMAIN=konkursy.example.pl
# An e-mail address for Let's Encrypt; "internal" gives a certificate from
# Caddy's own authority, for a test machine only.
CADDY_TLS=admin@example.pl

# Three different passwords: the database owner, the migrations, the API.
POSTGRES_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=

# openssl rand -base64 32; a copy outside the server, see docs/wdrozenie.md.
FIELD_ENCRYPTION_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=OCWIP

RATE_LIMIT_PERMIT_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# The host ports of Caddy, only for a machine that may not bind below 1024
# (rootless containers). A server leaves them out and gets 80 and 443.
# HTTP_PORT=80
# HTTPS_PORT=443

# Backups (T-114): a restic repository off the server, in the EU, reached with
# a key that may only add (docs/wdrozenie.md, "Kopie zapasowe"). The password
# encrypts every copy; without it the copies are useless, so keep it outside
# the server as well, next to FIELD_ENCRYPTION_KEY.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# The storage's own keys: AWS_* for S3 compatible storage, B2_* for Backblaze.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Cron syntax, Polish time.
BACKUP_SCHEDULE=0 2 * * *

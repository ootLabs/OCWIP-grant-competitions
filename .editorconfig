root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
# Treat unused usings and missing awaits as build errors, not suggestions.
dotnet_diagnostic.CS8019.severity = warning

[*.{csproj,sln,props}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

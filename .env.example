# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
POSTGRES_USER=ocwip
POSTGRES_PASSWORD=ocwip
POSTGRES_DB=ocwip
POSTGRES_PORT=5432

# --- Backend (.NET) ---
BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Hostname "db" is the compose service name, not localhost.
DATABASE_URL=Host=db;Port=5432;Database=ocwip;Username=ocwip;Password=ocwip
# Comma separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# Used by the browser, so it must be reachable from the host, not from the network.
NEXT_PUBLIC_API_URL=http://localhost:8080

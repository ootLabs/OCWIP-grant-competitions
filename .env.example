# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
POSTGRES_USER=ocwip
POSTGRES_PASSWORD=ocwip
POSTGRES_DB=ocwip
POSTGRES_PORT=5432

# --- Backend (.NET) ---
BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Hostname "db" is the compose service name, not localhost.
DATABASE_URL=Host=db;Port=5432;Database=ocwip;Username=ocwip;Password=ocwip
# Comma separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Public address of the frontend. Verification and password reset links in
# account mail are built from it, so on another FRONTEND_PORT change it too.
FRONTEND_BASE_URL=http://localhost:3000
# Host names the API answers to, separated by ";". "*" only for the local stack.
ALLOWED_HOSTS=*
#
# With ASPNETCORE_ENVIRONMENT=Production the API refuses to start (T-91) while
# DATABASE_URL or DEV_SMTP_HOST is empty, FRONTEND_BASE_URL or any CORS_ORIGINS
# entry is not a public https address, or ALLOWED_HOSTS is "*". The error
# names every key that is wrong. Development checks none of this.
#
# The relay check does not save you here: DEV_SMTP_HOST below defaults to the
# Mailpit container, so a Production start from this file passes it and sends
# every link to a mailbox with no password on it. The check cannot refuse the
# name either, because staging runs Production against Mailpit on purpose
# (docs/architektura.md). A real deployment takes .env.prod, never this file.

# --- Session cookie (T-12.3) ---
# Inactivity, in hours, before the session cookie stops being accepted.
AUTH_SESSION_LIFETIME_HOURS=8
# The ceiling on one session, in hours, counted from the sign in and not moved
# by activity (S-17): without it a stolen cookie of a session somebody keeps
# using never expires.
AUTH_SESSION_ABSOLUTE_HOURS=24
# Lax, Strict or None. None also requires AUTH_SECURE_COOKIE=true, and is only
# needed when the frontend and the API end up on different sites.
AUTH_COOKIE_SAME_SITE=Lax
# None drops the protection the cookie carries on its own, so Production
# refuses to start on it unless this says the split is intended (S-15).
# CrossSiteRequestFilter still refuses a request that says it comes from
# somewhere else, whatever this is set to.
AUTH_ALLOW_CROSS_SITE_COOKIE=
# Leave EMPTY unless you mean to override. Empty means "let the API decide",
# and it decides Secure everywhere except Development, where the local stack
# serves plain http and a browser would silently drop a Secure cookie. Spelling
# false here would carry that local exception into production.
AUTH_SECURE_COOKIE=

# --- Brute force protection (T-12.5) ---
# Wrong passwords in a row before an account locks temporarily.
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
# How long that lockout lasts. There is no unlock screen, so this is the only
# way out of it.
AUTH_LOCKOUT_MINUTES=15
# Requests per RATE_LIMIT_WINDOW_SECONDS from one address to /login,
# /register, /forgot-password, /reset-password or /resend-verification,
# shared across all of them.
#
# COUNTED PER CLIENT ADDRESS, and the API reads that address off the
# connection. Two consequences worth knowing before this goes public:
#
# 1. Behind a reverse proxy every request arrives from the proxy, so the whole
#    product would share ONE budget and the tenth sign in anywhere inside a
#    minute would answer 429. docker-compose.prod.yml therefore names
#    Caddy's fixed address in ForwardedHeaders__KnownProxies (T-111), and
#    only that sender may pass the client's address on. NOT
#    ASPNETCORE_FORWARDEDHEADERS_ENABLED: that switch trusts every sender, so
#    an attacker would pick a new address per try.
# 2. One office behind one NAT, or a group of people on one mobile carrier
#    address, also share the budget. Raise the limit for such a deployment.
#    Counting per address AND per typed-in e-mail instead would give an
#    attacker a fresh budget per address tried, which is the attack this
#    setting exists to stop, so the limit is the lever, not the partition.
RATE_LIMIT_PERMIT_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Attachments (T-32) ---
# Where uploaded application attachments are stored inside the backend
# container. Backed by the attachments-data volume, so it survives a rebuild.
ATTACHMENTS_STORAGE_PATH=/data/attachments

# Background jobs (T-105): the reminder three days before an intake closes.
# One API instance is assumed (docs/architektura.md). false turns every job
# off; the interval is how often the scheduler looks, at least 5 seconds.
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOBS_INTERVAL_SECONDS=60

# --- Session keys (T-113) ---
# Where the DataProtection key ring lives. Keep it on a volume: without it
# every new container signs everybody out and voids the links in account
# mail. Production refuses to start without it.
DATA_PROTECTION_KEYS_PATH=/data/keys

# Key the sensitive fields are encrypted with (T-47a): base64 of 32 random
# bytes, `openssl rand -base64 32`. Not used by the development compose,
# which takes the development key from appsettings.Development.json; the
# production compose (T-111) passes it as FieldEncryption__Keys__1. Losing it
# loses the data: keep a copy off the server, apart from the database
# backups (docs/wdrozenie.md, "Klucz szyfrowania"). Production refuses to
# start without it.
FIELD_ENCRYPTION_KEY=

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# Used by the browser, so it must be reachable from the host, not from the network.
NEXT_PUBLIC_API_URL=http://localhost:8080
# The same API seen from INSIDE the frontend container, which is where a server
# rendered public page (T-23) makes its calls from. "backend" is the compose
# service name; the address above points at the frontend container itself there
# and nothing answers on it. Leave unset outside compose and the browser
# address is used for both.
API_SERVER_URL=http://backend:8080
# Source of the OpenAPI document for npm run api:generate. Read inside the
# frontend container, so "backend" is the compose service name. The document is
# served in Development only.
OPENAPI_URL=http://backend:8080/openapi/v1.json

# --- Mail relay in the development stack (T-43a) ---
# DEV_SMTP_* and not SMTP_*, on purpose: only docker-compose.yml reads this
# file, and the names had to change to let the defaults point at Mailpit
# without an older .env (SMTP_PORT=587, SMTP_ENABLE_SSL=true) silently
# breaking every mail. Production, staging and the backup test machine keep
# the SMTP_* names, see .env.prod.example.
#
# Left as they are, the whole account mail goes to Mailpit (below), which is
# part of the plain stack. Empty DEV_SMTP_HOST instead keeps mail inside the
# system: in Development the whole mail goes to the backend log (follow a
# verification link from there), in any other environment only its subject,
# with a warning.
DEV_SMTP_HOST=mailpit
# Mailpit's SMTP inside the compose network, plain, no STARTTLS. A real relay
# wants 587 with DEV_SMTP_ENABLE_SSL=true; 465 (TLS from the first byte) is
# not supported, and the API refuses to start on it.
DEV_SMTP_PORT=1025
DEV_SMTP_ENABLE_SSL=false
DEV_SMTP_USER=
# A secret. Never commit a real one; set it in the deployment's environment.
DEV_SMTP_PASSWORD=
# Required once a host is set: the API refuses to start with a host and no
# sender. Nothing reads mail from this address, it only has to be an address.
DEV_SMTP_FROM=konkursy@ocwip.local
DEV_SMTP_FROM_NAME=OCWIP

# Mailpit, the development mailbox and the one the browser test reads (T-100).
# Starts with the plain "docker compose up -d"; its API and web view answer on
# this port, so the mailbox is at http://localhost:8025.
MAILPIT_PORT=8025
# Mailpit's SMTP on the host, for a sender outside the stack such as
# scripts/monitor.py when trying the alerts (T-116).
MAILPIT_SMTP_PORT=1025

# Copy to .env and adjust. Never commit .env.

# --- Postgres ---
POSTGRES_USER=ocwip
POSTGRES_PASSWORD=ocwip
POSTGRES_DB=ocwip
POSTGRES_PORT=5432

# --- Backend (.NET) ---
BACKEND_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# Hostname "db" is the compose service name, not localhost.
DATABASE_URL=Host=db;Port=5432;Database=ocwip;Username=ocwip;Password=ocwip
# Comma separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Session cookie (T-12.3) ---
# Inactivity, in hours, before the session cookie stops being accepted.
AUTH_SESSION_LIFETIME_HOURS=8
# Lax, Strict or None. None also requires AUTH_SECURE_COOKIE=true, and is only
# needed when the frontend and the API end up on different sites.
AUTH_COOKIE_SAME_SITE=Lax
# Leave EMPTY unless you mean to override. Empty means "let the API decide",
# and it decides Secure everywhere except Development, where the local stack
# serves plain http and a browser would silently drop a Secure cookie. Spelling
# false here would carry that local exception into production.
AUTH_SECURE_COOKIE=

# --- Brute force protection (T-12.5) ---
# Wrong passwords in a row before an account locks temporarily.
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
# How long that lockout lasts. There is no unlock screen, so this is the only
# way out of it.
AUTH_LOCKOUT_MINUTES=15
# Requests per RATE_LIMIT_WINDOW_SECONDS from one address to /login,
# /register, /forgot-password, /reset-password or /resend-verification,
# shared across all of them.
#
# COUNTED PER CLIENT ADDRESS, and the API reads that address off the
# connection. Two consequences worth knowing before this goes public:
#
# 1. Behind a reverse proxy every request arrives from the proxy, so the whole
#    product would share ONE budget and the tenth sign in anywhere inside a
#    minute would answer 429. Such a deployment has to set
#    ASPNETCORE_FORWARDEDHEADERS_ENABLED=true together with the list of
#    trusted proxies. See T-48.
# 2. One office behind one NAT, or a group of people on one mobile carrier
#    address, also share the budget. Raise the limit for such a deployment.
#    Counting per address AND per typed-in e-mail instead would give an
#    attacker a fresh budget per address tried, which is the attack this
#    setting exists to stop, so the limit is the lever, not the partition.
RATE_LIMIT_PERMIT_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
# Used by the browser, so it must be reachable from the host, not from the network.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Source of the OpenAPI document for npm run api:generate. Read inside the
# frontend container, so "backend" is the compose service name. The document is
# served in Development only.
OPENAPI_URL=http://backend:8080/openapi/v1.json

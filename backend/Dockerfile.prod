# Production image of the API (T-110). The development image is Dockerfile,
# with the SDK and dotnet watch; this one publishes once and runs on the
# ASP.NET runtime alone, as a user without root.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Restore with only the project file copied, so a source edit keeps the
# package cache layer. The tests are not part of the image.
COPY src/Ocwip.Api/Ocwip.Api.csproj src/Ocwip.Api/
RUN dotnet restore src/Ocwip.Api/Ocwip.Api.csproj

COPY src/ src/
RUN dotnet publish src/Ocwip.Api/Ocwip.Api.csproj -c Release -o /app --no-restore

# The migrations as one executable (T-113), run once before the API starts,
# as a role that may change the schema: the API itself connects as one that
# may only read and write rows. Built with --target migrate.
FROM build AS bundle
RUN dotnet tool install --global dotnet-ef --version 10.0.4
ENV PATH="${PATH}:/root/.dotnet/tools"
# The design time factory insists on a connection string, and building the
# bundle opens no connection: a placeholder, never a real address or secret.
RUN ConnectionStrings__Postgres="Host=unused;Database=unused" \
    dotnet ef migrations bundle --project src/Ocwip.Api/Ocwip.Api.csproj \
    --configuration Release --output /efbundle

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS migrate
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=bundle /efbundle ./efbundle
USER $APP_UID
# The connection comes from ConnectionStrings__Postgres, like the API's.
ENTRYPOINT ["./efbundle"]

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app ./

# S-21: the development settings carry a field encryption key that is in the
# repository, and dotnet publish takes every appsettings.* along. The image
# sets ASPNETCORE_ENVIRONMENT=Production, so the file is never read here, but
# a key that protects nothing has no business travelling to a server at all.
RUN rm -f appsettings.Development.json

# The starting content of a competition (application form, evaluation cards),
# read by the import command of T-96. It sits beside the project, not inside
# it, so dotnet publish does not take it along.
COPY seed/ ./seed/

# Npgsql probes GSSAPI on every connection and logs an error when the
# library is missing; the runtime image does not carry it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

# Attachments and the DataProtection key ring (T-113) live on volumes
# mounted here. Created and handed to the app
# user now, because a named volume takes over the ownership of the directory
# it is mounted on, and root's would leave every upload failing.
RUN mkdir -p /data/attachments /data/keys && chown "$APP_UID" /data/attachments /data/keys

# The runtime image's own non-root user (UID 1654), not root.
USER $APP_UID

# Europe/Warsaw has to resolve: without it exports and intake messages fall
# back to UTC (ApplicationListLabels). The runtime image ships tzdata; this
# fails the build if a future base image stops doing so.
RUN test -f /usr/share/zoneinfo/Europe/Warsaw

ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_HTTP_PORTS=8080 \
    DataProtection__KeysPath=/data/keys

EXPOSE 8080

ENTRYPOINT ["dotnet", "Ocwip.Api.dll"]

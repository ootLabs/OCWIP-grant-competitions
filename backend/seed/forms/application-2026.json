          "printed": true,
          "role": "applicantType",
          "help": "Organizacja może złożyć wniosek sama albo jako patron grupy nieformalnej.",
          "options": [
            {
              "value": "Organisation",
              "label": "A. Młoda albo lokalna organizacja pozarządowa"
            },
            {
              "value": "PatronInformalGroup",
              "label": "B. Grupa nieformalna z patronem"
            },
            {
              "value": "InformalGroup",
              "label": "C. Grupa nieformalna"
            }
          ]
        },
        {

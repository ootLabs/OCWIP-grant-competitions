{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Cors": {
    "Origins": "http://localhost:3000"
  },
  "EmailVerification": {
    "FrontendBaseUrl": "http://localhost:3000",
    "TokenLifetimeHours": 24,
    "ResendCooldownSeconds": 60,
    "ResendCooldownMaxSeconds": 1800,
    "ResendCooldownMultiplier": 5,
    "ResendCooldownResetSeconds": 86400
  },
  "PasswordReset": {
    "TokenLifetimeHours": 1,
    "CooldownSeconds": 60,
    "CooldownMaxSeconds": 1800,
    "CooldownMultiplier": 5,
    "CooldownResetSeconds": 86400
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "Attachments": {
    "StoragePath": "/data/attachments"
  }
}
